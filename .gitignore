doc/

# Generated: sync-content.js rebuilds this from content/<version>/ on every
# `npm run build` (which CI runs), so the source of truth is content/, not here.
# This used to be covered accidentally by a bare `docs/` rule — kept explicit
# so deleting that rule doesn't start tracking six generated files.
