---
import '../styles/global.css';
import { siteConfig } from '../config';
import QRCode from 'qrcode';
import ReleaseBadge from '../components/ReleaseBadge.astro';

interface Props {
  title: string;
  description?: string;
  /** Overrides the document language (e.g. the German Impressum). */
  lang?: string;
  /** Keeps legal / duplicate pages out of the index while staying reachable. */
  noindex?: boolean;
  /** og:type — 'website' for landing pages, 'article' for the spec documents. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects merged into the sitewide @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  lang = 'en',
  noindex = false,
  ogType = 'website',
  schema = [],
} = Astro.props;
const currentPath = Astro.url.pathname;
const version = siteConfig.version;

// Build provenance.
//
// Under the promotion model nothing is built in the gated path — a release
// activates bytes that already exist — so the RECEIPT id cannot appear here:
// the artifact was built before the receipt existed, and injecting it would
// mean rebuilding, which is the thing promotion avoids. Same circularity as a
// page containing its own fingerprint, one level up.
//
// What the page CAN state truthfully is which commit it was built from, taken
// from the host's own build variable. That is provenance, not proof of
// authority. The receipt link returns when the Authority Server can answer
// "which receipt released this build?" — see doc/deploy-promote-plan.md P8.
const deploySha = process.env.VERCEL_GIT_COMMIT_SHA ?? process.env.PUBLIC_DEPLOY_SHA;
const deployShaShort = typeof deploySha === 'string' ? deploySha.slice(0, 7) : '';

// One canonical URL per page, used by the QR code, <link rel="canonical">, and
// the Open Graph tags alike — they must not be allowed to disagree.
//
// Astro emits directory-style output (/protocol/index.html), so the runtime
// pathname can carry a trailing slash while every internal link is written
// without one. Normalise to the no-slash form and let vercel.json redirect the
// slashed variant, so exactly one URL is ever advertised.
const origin = (Astro.site ?? new URL(siteConfig.url)).origin;
const canonicalPath = currentPath !== '/' ? currentPath.replace(/\/$/, '') : '/';
const pageUrl = new URL(canonicalPath, origin).href;
const ogImageUrl = new URL(siteConfig.ogImage, origin).href;

// Sitewide entity graph. Anchored with @id so page-level schema (TechArticle,
// BreadcrumbList) can point back at the publisher instead of redeclaring it.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: siteConfig.title,
      alternateName: 'HAP',
      url: `${origin}/`,
      logo: new URL('/favicon.svg', origin).href,
      description: siteConfig.description,
      // sameAs asserts identity, and HAP and Suveren are separate entities:
      // HAP is the neutral open protocol, Suveren a commercial implementation
      // based on it. Only the GitHub org is the same entity as this site.
      // Suveren stays a factual reference (footer, llms.txt), not an identity.
      sameAs: [siteConfig.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      name: siteConfig.title,
      url: `${origin}/`,
      inLanguage: 'en',
      publisher: { '@id': `${origin}/#organization` },
    },
    ...schema,
  ],
};
const shareQrSvg = await QRCode.toString(pageUrl, {
  type: 'svg',
  margin: 0,
  color: { dark: '#111111', light: '#ffffff' },
});
// Drop the brand prefix for a clean label; hide the line if it equals the brand.
const shareTitle = title.replace(/^(HAP|Human Agency Protocol)\s*[-–—|:]\s*/i, '');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={pageUrl}>
    {noindex && <meta name="robots" content="noindex, follow">}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable context">
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} — specification releases`} href="/rss.xml">
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={siteConfig.title}>
    <meta property="og:locale" content={lang === 'de' ? 'de_AT' : 'en_US'}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Human Agency Protocol — no receipt, no execution.">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
    <nav>
        <div class="container">
            <div class="logo-group">
                <a href="/" class="logo">Human Agency Protocol</a>
                <span class="version-badge">v{version}</span>
            </div>
            <ReleaseBadge />
            <button class="nav-share" id="share-toggle" type="button" aria-label="Share this page">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
            </button>
            <button class="burger" id="burger-menu" aria-label="Toggle menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul id="nav-menu">
                <li><a href="/protocol" class={currentPath.startsWith('/protocol') ? 'active' : ''}>Protocol</a></li>
                <li><a href="/governance" class={currentPath.startsWith('/governance') ? 'active' : ''}>Governance</a></li>
                <li><a href="/changelog" class={currentPath.startsWith('/changelog') ? 'active' : ''}>Changelog</a></li>
                <li><a href="/review" class={currentPath.startsWith('/review') ? 'active' : ''}>Review</a></li>
                <li><a href="https://github.com/humanagencyprotocol/hap-protocol" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            </ul>
        </div>
    </nav>

    <div class="share-overlay" id="share-overlay" role="dialog" aria-modal="true" aria-label="Share this page">
        <div class="share-modal">
            <button class="share-close" id="share-close" type="button" aria-label="Close">×</button>
            <div class="share-brand">humanagencyprotocol.org</div>
            {shareTitle && shareTitle !== siteConfig.title && <div class="share-title">{shareTitle}</div>}
            <div class="share-qr" set:html={shareQrSvg}></div>
            <div class="share-url">{pageUrl}</div>
        </div>
    </div>

    <slot />

    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h4>Protocol</h4>
                <ul>
                    <li><a href="/protocol">Overview</a></li>
                    <li><a href="/protocol#profiles">Profiles</a></li>
                    <li><a href="/protocol#commitment-modes">Commitment Modes</a></li>
                    <li><a href="/protocol#execution-receipts">Execution Receipts</a></li>
                    <li><a href="/protocol#authority-server-behavior">Authority Server</a></li>
                    <li><a href="/protocol#gatekeeper--executor-behavior">Gatekeeper</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4>Community</h4>
                <ul>
                    <li><a href="/governance">Governance</a></li>
                    <li><a href="/changelog">Changelog</a></li>
                    <li><a href="/review">Review</a></li>
                    <li><a href={siteConfig.implementation} target="_blank" rel="noopener">Suveren — a conforming implementation</a></li>
                    <li><a href={siteConfig.github}>GitHub</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p><a href="/impress">Impress</a> | The Human Agency Protocol is open infrastructure. Licensed under MIT. Maintained by stewards, not owners.</p>
            {deploySha && (
                <p class="deploy-proof">
                    Built from <a href={`https://github.com/humanagencyprotocol/hap-protocol/commit/${deploySha}`}><code>{deployShaShort}</code></a>
                </p>
            )}
        </div>
    </footer>
</body>
</html>

<style>
    footer {
        max-width: 1200px;
        margin: 8rem auto 0;
        padding: 4rem 2rem;
        border-top: 1px solid var(--border);
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 3rem;
    }

    .footer-section h4 {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .footer-section ul {
        list-style: none;
        margin: 0;
    }

    .footer-section ul li {
        margin-bottom: 0.75rem;
    }

    .footer-section a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s;
    }

    .footer-section a:hover {
        color: var(--accent);
    }

    .footer-bottom {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        color: var(--text-tertiary);
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        footer {
            margin-top: 4rem;
        }
    }
</style>

<script>
    // Burger menu toggle
    const burger = document.getElementById('burger-menu');
    const navMenu = document.getElementById('nav-menu');

    burger?.addEventListener('click', () => {
        burger.classList.toggle('active');
        navMenu?.classList.toggle('active');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
        if (!burger?.contains(e.target as Node) && !navMenu?.contains(e.target as Node)) {
            burger?.classList.remove('active');
            navMenu?.classList.remove('active');
        }
    });

    // Close menu when clicking a link
    navMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            burger?.classList.remove('active');
            navMenu?.classList.remove('active');
        });
    });

    // Share popup (mobile QR)
    const shareToggle = document.getElementById('share-toggle');
    const shareOverlay = document.getElementById('share-overlay');
    const shareClose = document.getElementById('share-close');
    const closeShare = () => shareOverlay?.classList.remove('open');
    shareToggle?.addEventListener('click', () => shareOverlay?.classList.add('open'));
    shareClose?.addEventListener('click', closeShare);
    shareOverlay?.addEventListener('click', (e) => {
        if (e.target === shareOverlay) closeShare();
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeShare();
    });
</script>
