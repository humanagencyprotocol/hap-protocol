# build output — TRACKED ON PURPOSE, and written only by CI.
#
# Vercel serves dist/ directly instead of building (see vercel.json), so the
# bytes here are the bytes that go live. That is what makes a release
# verifiable: git's commit sha is already a digest over the artifact, so a
# receipt binding the commit binds the exact site, not just its address.
#
# Never commit dist/ by hand. Build locally as much as you like — just let
# .github/workflows/build-website.yml be the only thing that commits the
# result, or the repo can end up holding source and output that disagree.

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# synced content (auto-generated from source, but committed for Vercel)
# Note: These are synced on every build via npm run sync
# src/content/docs/*.md
# src/sdk-docs/*.md
